{% extends "tracker/base.html" %}

{% block title %}
Add Expense | ISC Pool Tracker
{% endblock %}

{% block content %}

<div class="form-page">

    <div class="form-card">

        <div class="form-header">

            <h1>
                {% if editing %}
                    Edit Expense
                {% else %}
                    Add Expense
                {% endif %}
            </h1>

            <p>
                Record an ISC Pool business expense.
            </p>

        </div>


        <form method="post">

            {% csrf_token %}

            {% if form.non_field_errors %}
                <div class="form-errors">
                    {{ form.non_field_errors }}
                </div>
            {% endif %}


            <div class="form-group">

                <label for="{{ form.date.id_for_label }}">
                    Date
                </label>

                {{ form.date }}

                {% if form.date.errors %}
                    <div class="field-error">
                        {{ form.date.errors }}
                    </div>
                {% endif %}

            </div>


            <div class="form-group">

                <label for="{{ form.expense_type.id_for_label }}">
                    Expense Type
                </label>

                {{ form.expense_type }}

                {% if form.expense_type.errors %}
                    <div class="field-error">
                        {{ form.expense_type.errors }}
                    </div>
                {% endif %}

            </div>


            <div class="form-group">

                <label for="{{ form.amount.id_for_label }}">
                    Amount (KSh)
                </label>

                {{ form.amount }}

                {% if form.amount.errors %}
                    <div class="field-error">
                        {{ form.amount.errors }}
                    </div>
                {% endif %}

            </div>


            <div class="form-group">

                <label for="{{ form.notes.id_for_label }}">
                    Notes
                </label>

                {{ form.notes }}

                {% if form.notes.errors %}
                    <div class="field-error">
                        {{ form.notes.errors }}
                    </div>
                {% endif %}

            </div>


            <div class="form-actions">

                <a
                    href="{% url 'dashboard' %}"
                    class="button secondary"
                >
                    Cancel
                </a>

                <button
                    type="submit"
                    class="button expense"
                >
                    {% if editing %}
                        Update Expense
                    {% else %}
                        Save Expense
                    {% endif %}
                </button>

            </div>

        </form>

    </div>

</div>

{% endblock %}