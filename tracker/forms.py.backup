from django import forms

from .models import DailyEarning, Expense


class DailyEarningForm(forms.ModelForm):

    class Meta:
        model = DailyEarning

        fields = [
            "date",
            "amount_collected",
            "notes",
        ]

        widgets = {
            "date": forms.DateInput(
                attrs={
                    "type": "date",
                    "class": "form-control",
                }
            ),

            "amount_collected": forms.NumberInput(
                attrs={
                    "type": "number",
                    "step": "0.01",
                    "min": "0",
                    "class": "form-control",
                    "placeholder": "Enter amount collected",
                }
            ),

            "notes": forms.Textarea(
                attrs={
                    "rows": 3,
                    "class": "form-control",
                    "placeholder": "Optional notes",
                }
            ),
        }


class ExpenseForm(forms.ModelForm):

    class Meta:
        model = Expense

        fields = [
            "date",
            "expense_type",
            "amount",
            "notes",
        ]

        widgets = {
            "date": forms.DateInput(
                attrs={
                    "type": "date",
                    "class": "form-control",
                }
            ),

            "expense_type": forms.Select(
                attrs={
                    "class": "form-control",
                }
            ),

            "amount": forms.NumberInput(
                attrs={
                    "type": "number",
                    "step": "0.01",
                    "min": "0",
                    "class": "form-control",
                    "placeholder": "Enter expense amount",
                }
            ),

            "notes": forms.Textarea(
                attrs={
                    "rows": 3,
                    "class": "form-control",
                    "placeholder": "Optional notes",
                }
            ),
        }