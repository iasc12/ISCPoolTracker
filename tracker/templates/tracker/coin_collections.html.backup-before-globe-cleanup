{% extends "tracker/base.html" %}

{% block title %}Coin Collections - ISC Pool Tracker
<style id="isc-real-coin-system">

/* =========================================================
   COIN RECORD LAYOUT
   ========================================================= */

.coin-table .table-coin {
    display: inline-flex !important;
    align-items: center !important;
    justify-content: flex-start !important;
    gap: 9px !important;
    white-space: nowrap !important;
}

.coin-table .table-coin strong {
    display: inline-block !important;
    line-height: 1 !important;
}


/* =========================================================
   REAL SILVER COIN
   ========================================================= */

.coin-table .record-coin-svg {
    position: relative !important;

    display: inline-flex !important;
    align-items: center !important;
    justify-content: center !important;

    width: 32px !important;
    height: 32px !important;

    flex: 0 0 32px !important;

    transform-origin: 50% 50% !important;
    transform-style: flat !important;

    will-change: transform !important;

    animation: iscRecordCoinWheel 2.8s linear infinite !important;
}

.coin-table .record-coin-svg svg {
    display: block !important;

    width: 32px !important;
    height: 32px !important;

    overflow: visible !important;

    filter:
        drop-shadow(0 2px 2px rgba(0,0,0,.20)) !important;
}


/* =========================================================
   RECORD COIN WHEEL
   ========================================================= */

@keyframes iscRecordCoinWheel {

    from {
        transform: rotateX(0deg);
    }

    to {
        transform: rotateX(360deg);
    }

}


/* =========================================================
   HEADER COIN
   ========================================================= */

.coin-title-area .header-silver-coin {

    animation:
        iscHeaderCoinWheel
        4s
        linear
        infinite !important;

    transform-origin: 50% 50% !important;

    transform-style: flat !important;

    backface-visibility: visible !important;

    opacity: 1 !important;

    visibility: visible !important;

    will-change: transform !important;
}

@keyframes iscHeaderCoinWheel {

    from {
        transform: rotateX(0deg);
    }

    to {
        transform: rotateX(360deg);
    }

}


/* =========================================================
   DARK MODE
   ========================================================= */

body.dark-mode .coin-table .record-coin-svg svg {

    filter:
        drop-shadow(0 3px 5px rgba(0,0,0,.38)) !important;
}


/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {

    .coin-table .record-coin-svg,
    .coin-title-area .header-silver-coin {

        animation: none !important;
    }

}


/* =========================================================
   PREMIUM HEADER SILVER COIN
   ========================================================= */

.coin-title-area .header-silver-coin {
    width: 60px !important;
    height: 60px !important;
    flex: 0 0 60px !important;

    border-radius: 50% !important;

    position: relative !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    background:
        radial-gradient(
            circle at 31% 25%,
            #ffffff 0%,
            #f8fafb 14%,
            #dfe3e6 30%,
            #aeb6bd 48%,
            #f4f6f7 66%,
            #9ba4ac 82%,
            #68727b 100%
        ) !important;

    border: 3px solid #737d86 !important;

    box-shadow:
        inset 0 0 0 2px rgba(255,255,255,.92),
        inset 0 0 0 5px rgba(91,101,110,.28),
        inset 0 5px 8px rgba(255,255,255,.55),
        inset 0 -5px 9px rgba(58,67,75,.32),
        0 4px 8px rgba(15,23,42,.24),
        0 0 0 2px rgba(255,255,255,.35) !important;

    transform-origin: center center !important;
    transform-style: preserve-3d !important;

    backface-visibility: visible !important;
    -webkit-backface-visibility: visible !important;

    animation: iscHeaderCoinWheel 2.4s linear infinite !important;

    will-change: transform !important;
}

/* Raised inner coin face */
.coin-title-area .header-silver-coin::before {
    content: "" !important;
    position: absolute !important;

    inset: 7px !important;

    border-radius: 50% !important;

    border: 2px solid rgba(105,115,124,.55) !important;

    box-shadow:
        inset 0 2px 3px rgba(255,255,255,.9),
        inset 0 -2px 3px rgba(70,80,88,.22),
        0 0 0 1px rgba(255,255,255,.5) !important;

    pointer-events: none !important;
}

/* Raised 20 engraving */
.coin-title-area .header-silver-coin::after {
    content: "20" !important;

    position: absolute !important;
    inset: 0 !important;

    display: flex !important;
    align-items: center !important;
    justify-content: center !important;

    font-family: Georgia, "Times New Roman", serif !important;
    font-size: 21px !important;
    font-weight: 900 !important;
    letter-spacing: -.5px !important;

    color: #69747d !important;

    text-shadow:
        1px 1px 0 #ffffff,
        0 2px 1px rgba(70,80,90,.20),
        -1px -1px 0 rgba(255,255,255,.7) !important;

    pointer-events: none !important;
}

/* Continuous rotation */
@keyframes iscHeaderCoinWheel {
    from {
        transform: rotateX(0deg);
    }

    to {
        transform: rotateX(360deg);
    }
}

/* Keep it moving even when the mouse is over it */
.coin-title-area .header-silver-coin:hover {
    animation: iscHeaderCoinWheel 2.4s linear infinite !important;
}

/* Slightly smaller on phones */
@media (max-width: 600px) {
    .coin-title-area .header-silver-coin {
        width: 52px !important;
        height: 52px !important;
        flex-basis: 52px !important;
    }

    .coin-title-area .header-silver-coin::after {
        font-size: 18px !important;
    }
}

/* Respect accessibility settings */
@media (prefers-reduced-motion: reduce) {
    .coin-title-area .header-silver-coin {
        animation: none !important;
    }
}

</style>
{% endblock %}

